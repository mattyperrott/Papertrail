# Optional. Without this key Papertrail uses Polymarket's public Data API.
ARKHAM_API_KEY=
ARKHAM_API_BASE=https://api.arkm.com

PORT=8787
POLL_INTERVAL_MS=15000
RESULT_VERIFICATION_INTERVAL_MS=300000
# Full trader rescan followed by paper deployment. Clamped to 5-10 minutes.
AUTO_DEPLOY_INTERVAL_MS=300000

# No live execution mode exists. Every restart begins with entries paused.
TRADING_MODE=paper
# Paper-only alert delivery. Keep the real values in a mode-0600 .env file.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
CONDITIONAL_AUTO_RESUME=false
APPROVED_CODE_HASH=
# Job watchdog and bounded shutdown; see docs/OPERATIONS.md.
JOB_DEADLINE_MS=300000
SCAN_DEADLINE_MS=900000
SHUTDOWN_DRAIN_MS=60000
# Trader discovery cadence inside automatic deploy cycles (manual Scan & deploy always rescans).
DISCOVERY_INTERVAL_MS=3600000
